# Copy to .env for local development. In production set these in Vercel → Settings → Environment Variables.
# Leave GITHUB_TOKEN empty locally: the panel then writes to src/data/ on this machine.
GITHUB_TOKEN=
GITHUB_REPO=drazomo/novo-ringo-bar
GITHUB_BRANCH=main
PANEL_SECRET=
PANEL_EMAILS=
RESEND_API_KEY=
PANEL_MAIL_FROM=Panel Ringo <panel@ringopizzeria.com>
