---
// Panel Ringo → "Imprimir QR": print-ready A4 sheets whose QR opens the carta.
// Static page (no login needed: it only shows public info). Not indexed.
import "../../styles/base.css";
import { getImage } from "astro:assets";
import logo from "../../assets/site/logo.png";
import site from "../../data/site.json";
import { qrSvg, QR_LABEL } from "../../lib/qr";

const lg = await getImage({ src: logo, width: 400, format: "png" });
const qr = await qrSvg();
const addr = `${site.address.street.replace("Carrer de ", "C/ ")}, ${site.address.city}`;

const sheets = [
  { id: "cartel", name: "Cartel", hint: "1 por hoja A4 · para la puerta, el escaparate o la barra" },
  { id: "mesa", name: "Tarjetas de mesa", hint: "4 por hoja A4 · recorta por la línea de puntos" },
  { id: "pegatinas", name: "Pegatinas", hint: "12 por hoja A4 · en papel adhesivo, para cajas de pizza o bolsas" },
];
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Imprimir QR · Panel Ringo</title>
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#1C1714">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<style>
  /* ---------- screen: the tool ---------- */
  body{margin:0;background:var(--cream);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}
  .ui{max-width:760px;margin:0 auto;padding:calc(14px + env(safe-area-inset-top)) 18px 60px}
  .top{display:flex;align-items:center;gap:12px;margin-bottom:18px}
  .back{display:grid;place-items:center;width:44px;height:44px;border-radius:999px;background:#fff;border:1px solid var(--line);color:var(--ink);text-decoration:none;font-size:20px}
  .top h1{font:600 26px/1.1 var(--serif);margin:0}
  .intro{background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px 18px;font-size:15.5px;line-height:1.5;color:var(--ink-2)}
  .intro b{color:var(--ink)}
  .intro code{font-family:var(--sans);font-weight:700;color:var(--tomato-dk);word-break:break-all}
  .fmt{margin-top:26px}
  .fmt-head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:10px}
  .fmt-head h2{font:600 21px/1.15 var(--serif);margin:0}
  .fmt-head p{margin:4px 0 0;font-size:14px;color:var(--ink-3)}
  .btn{flex:none;display:inline-flex;align-items:center;gap:8px;min-height:48px;padding:0 20px;border-radius:999px;border:0;background:var(--tomato);color:#fff;font:700 15.5px var(--sans);cursor:pointer;text-decoration:none}
  .btn.ghost{background:#fff;color:var(--ink);border:1.5px solid var(--line)}
  .btn svg{width:19px;height:19px}
  .frame{background:#fff;border-radius:6px;box-shadow:0 10px 30px rgba(28,23,20,.14);overflow:hidden}
  .scaler{transform-origin:0 0}
  .dl{margin-top:30px;display:flex;flex-wrap:wrap;gap:10px}
  .tip{margin-top:14px;font-size:14px;line-height:1.5;color:var(--ink-3)}
  @media (max-width:560px){.fmt-head{flex-direction:column;align-items:stretch}.btn{justify-content:center}}

  /* ---------- the printable sheets (real mm sizes) ---------- */
  .sheet{width:210mm;height:297mm;box-sizing:border-box;background:#FBF7F0;color:#1C1714;position:relative;overflow:hidden;font-family:var(--sans)}
  .qr{position:relative;background:#fff;display:grid;place-items:center}
  .qr svg{display:block;width:100%;height:100%}
  .qr img{position:absolute;left:50%;top:50%;width:23%;transform:translate(-50%,-50%);border-radius:50%;background:#fff;box-shadow:0 0 0 1.6mm #fff}
  .eyebrow{font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#D3201B}
  .serif{font-family:var(--serif)}
  .it{font-style:italic;color:#D3201B}

  /* Cartel A4 */
  #cartel{padding:20mm 18mm 16mm;display:flex;flex-direction:column;align-items:center;text-align:center}
  #cartel .logo{width:34mm;height:34mm}
  #cartel .eyebrow{font-size:10.5pt;margin-top:7mm}
  #cartel h3{font:600 64pt/0.95 var(--serif);margin:5mm 0 0;letter-spacing:-.01em}
  #cartel .en{font:italic 400 19pt var(--serif);color:#5A4F47;margin-top:2mm}
  #cartel .qr{width:112mm;height:112mm;padding:7mm;border-radius:7mm;margin-top:10mm;box-shadow:0 0 0 .5mm #E2D5C3}
  #cartel .scan{font-size:15pt;font-weight:700;margin-top:9mm}
  #cartel .scan small{display:block;font-weight:400;font-size:12pt;color:#5A4F47;margin-top:1.5mm}
  #cartel .url{font-size:12pt;font-weight:700;color:#A9170F;margin-top:4mm}
  #cartel .foot{margin-top:auto;width:100%;border-top:.4mm solid #E2D5C3;padding-top:5mm;display:flex;justify-content:space-between;font-size:10.5pt;color:#5A4F47}

  /* 4 table cards (A6 each) */
  #mesa{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr}
  .card{border:.3mm dashed #CDBFAB;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:9mm 8mm}
  .card .head{display:flex;align-items:center;gap:3mm}
  .card .head img{width:13mm;height:13mm}
  .card .head b{font:600 17pt var(--serif)}
  .card h4{font:600 25pt/1 var(--serif);margin:5mm 0 0}
  .card .en{font:italic 400 11.5pt var(--serif);color:#5A4F47;margin-top:1mm}
  .card .qr{width:62mm;height:62mm;padding:4mm;border-radius:4mm;margin-top:5mm;box-shadow:0 0 0 .4mm #E2D5C3}
  .card .scan{font-size:10.5pt;font-weight:700;margin-top:5mm}
  .card .scan span{font-weight:400;color:#5A4F47}
  .card .url{font-size:9pt;font-weight:700;color:#A9170F;margin-top:1.5mm}

  /* 12 stickers (3 × 4) */
  #pegatinas{padding:8mm 7mm;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(4,1fr);gap:4mm}
  .stk{border:.3mm dashed #CDBFAB;border-radius:5mm;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:3mm}
  .stk .qr{width:40mm;height:40mm}
  .stk b{font:600 13pt var(--serif);margin-top:2.5mm}
  .stk small{font-size:8pt;color:#5A4F47;margin-top:.6mm}

  /* ---------- printing ---------- */
  @page{size:A4 portrait;margin:0}
  @media print{
    html,body{background:#fff}
    .ui>*:not(.fmt),.fmt-head,.no-print{display:none!important}
    .ui{max-width:none;padding:0;margin:0}
    .fmt{margin:0}
    body[data-print] .fmt:not(.printing){display:none!important}
    .frame{box-shadow:none;border-radius:0;height:auto!important;width:auto!important}
    .scaler{transform:none!important}
    .sheet{-webkit-print-color-adjust:exact;print-color-adjust:exact;break-after:page}
    .card,.stk{border-color:#CDBFAB}
  }
</style>
</head>
<body>
<main class="ui">
  <div class="top">
    <a class="back" href="/panel#inicio" aria-label="Volver al panel">‹</a>
    <h1>Imprimir QR</h1>
  </div>

  <div class="intro">
    Al escanear el QR, tus clientes abren tu carta: <code>{QR_LABEL}</code><br>
    <b>No hace falta volver a imprimirlo</b> cuando cambies precios o platos en el panel: el QR siempre muestra la carta actual.
  </div>

  {sheets.map((s) => (
    <section class="fmt" data-fmt={s.id}>
      <div class="fmt-head">
        <div><h2>{s.name}</h2><p>{s.hint}</p></div>
        <button class="btn" type="button" data-print={s.id}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v7H7z"/></svg>
          Imprimir
        </button>
      </div>
      <div class="frame"><div class="scaler">
        {s.id === "cartel" && (
          <div class="sheet" id="cartel">
            <img class="logo" src={lg.src} alt="Pizzería Ringo">
            <div class="eyebrow">Pizzería italiana · {site.address.neighbourhood}, València</div>
            <h3>Nuestra <span class="it">carta</span></h3>
            <div class="en">Our menu</div>
            <div class="qr"><Fragment set:html={qr} /><img src={lg.src} alt=""></div>
            <div class="scan">Escanea con la cámara del móvil<small>Scan with your phone camera</small></div>
            <div class="url">{QR_LABEL}</div>
            <div class="foot"><span>{addr}</span><span>{site.phoneDisplay}</span><span>{site.instagramHandle}</span></div>
          </div>
        )}
        {s.id === "mesa" && (
          <div class="sheet" id="mesa">
            {[0, 1, 2, 3].map(() => (
              <div class="card">
                <div class="head"><img src={lg.src} alt=""><b>Pizzería Ringo</b></div>
                <h4>La <span class="it">carta</span></h4>
                <div class="en">Our menu</div>
                <div class="qr"><Fragment set:html={qr} /><img src={lg.src} alt=""></div>
                <div class="scan">Escanea · <span>Scan me</span></div>
                <div class="url">{QR_LABEL}</div>
              </div>
            ))}
          </div>
        )}
        {s.id === "pegatinas" && (
          <div class="sheet" id="pegatinas">
            {Array.from({ length: 12 }).map(() => (
              <div class="stk">
                <div class="qr"><Fragment set:html={qr} /><img src={lg.src} alt=""></div>
                <b>Pizzería Ringo</b>
                <small>La carta · Menu</small>
              </div>
            ))}
          </div>
        )}
      </div></div>
    </section>
  ))}

  <div class="dl">
    <a class="btn ghost" href="/panel/qr-carta.png" download>Descargar QR (PNG)</a>
    <a class="btn ghost" href="/panel/qr-carta.svg" download>Descargar QR (SVG, para imprenta)</a>
  </div>
  <p class="tip">
    Desde el móvil: pulsa <b>Imprimir</b> y elige tu impresora, o <b>Guardar como PDF</b> para llevarlo a una copistería.
    Imprime en A4 al 100 % (sin «ajustar a la página»). Antes de repartirlo, escanéalo una vez con tu móvil.
  </p>
</main>

<script>
  // Fit each real-size A4 sheet into the screen width (printing ignores this).
  const fit = () => document.querySelectorAll<HTMLElement>(".frame").forEach((f) => {
    const sc = f.firstElementChild as HTMLElement, sheet = sc.firstElementChild as HTMLElement;
    const k = Math.min(1, f.parentElement!.clientWidth / sheet.offsetWidth);
    sc.style.transform = `scale(${k})`;
    f.style.width = sheet.offsetWidth * k + "px";
    f.style.height = sheet.offsetHeight * k + "px";
  });
  addEventListener("resize", fit); addEventListener("load", fit); fit();

  // Print only the chosen sheet.
  document.querySelectorAll<HTMLButtonElement>("[data-print]").forEach((b) => b.addEventListener("click", () => {
    document.querySelectorAll(".fmt").forEach((s) => s.classList.toggle("printing", s.getAttribute("data-fmt") === b.dataset.print));
    document.body.dataset.print = b.dataset.print!;
    print();
  }));
  addEventListener("afterprint", () => { delete document.body.dataset.print; });
</script>
</body>
</html>
