---
import "../styles/home.css";
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import { site, menu, hours, visibleCats, nameOf, descOf, catName, priceLabel, minPrice, eur, DAYS, openDaysPhrase, earliestOpen, photoOf, type Lang } from "../lib/data";
import { T, ROUTES } from "../lib/i18n";
import { restaurant, website, breadcrumbs, faq, graph } from "../lib/seo";
import hero from "../assets/site/p4.jpg";
import picksPhoto from "../assets/site/p1.jpg";
import logo from "../assets/site/logo.png";
import mapImg from "../assets/site/map.webp";
import g1 from "../assets/site/p7.jpg";
import g2 from "../assets/site/p8.jpg";
import g3 from "../assets/site/p3.jpg";
import g4 from "../assets/site/p6.jpg";
import g5 from "../assets/site/p5.jpg";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang];
const R = ROUTES[lang];
const es = lang === "es";
const cats = visibleCats();
const count = (id: string) => cats.find((c) => c.id === id)?.items.length ?? 0;
const days = openDaysPhrase(lang);
const from = earliestOpen();
const picks = menu.items.filter((i) => i.status !== "off" && (i.tags.includes("casa") || i.tags.includes("top")))
  .concat(menu.items.filter((i) => i.status !== "off" && i.cat === "pizzas" && !i.tags.includes("casa") && !i.tags.includes("top")))
  .slice(0, 5);
const meatFree = menu.items.filter((i) => i.status !== "off" && i.tags.includes("sincarne")).map((i) => nameOf(i, lang));
const leadCat = cats[0];

const title = es
  ? "Pizzería italiana en Valencia (Campanar) · Ringo Bar | Pizza a domicilio"
  : "Italian pizzeria in Valencia (Campanar) · Ringo Bar | Pizza delivery";
const description = es
  ? `Pizzería Ringo Bar: auténtica pizza italiana en Campanar, València. ${count("pizzas")} pizzas y ${count("calzones")} calzones. Abierto ${days} desde las ${from}. Pide a domicilio por Glovo o Uber Eats.`
  : `Ringo Bar: authentic Italian pizza in Campanar, Valencia. ${count("pizzas")} pizzas and ${count("calzones")} calzones. Open ${days} from ${from}. Order delivery on Glovo or Uber Eats.`;

const intro = es
  ? `Ringo Bar es una pizzería italiana en el barrio de Campanar, en ${site.address.street}, ${site.address.city}. Nuestro pizzaiolo, ${site.pizzaiolo}, prepara ${count("pizzas")} pizzas y ${count("calzones")} calzones, además de entrantes, paninis y postres. Abrimos ${days} desde las ${from}: para comer en el local, recoger o pedir a domicilio por Glovo y Uber Eats.`
  : `Ringo Bar is an Italian pizzeria in the Campanar neighbourhood of Valencia, at ${site.address.street}. Our pizzaiolo, ${site.pizzaiolo}, makes ${count("pizzas")} pizzas and ${count("calzones")} calzones, plus starters, panini and desserts. We're open ${days} from ${from}: eat in, pick up, or order delivery on Glovo and Uber Eats.`;

const hoursLine = (d: number) => (hours.week[d].length ? hours.week[d].map((s) => s.join(" – ")).join(" · ") : t.closedDay);
const closedDays = DAYS[lang].filter((_, d) => !hours.week[d].length);
const QA: [string, string][] = es ? [
  ["¿Dónde está la Pizzería Ringo Bar?", `En ${site.address.street}, ${site.address.postalCode} ${site.address.city}, en el barrio de Campanar. Teléfono: ${site.phoneDisplay}.`],
  ["¿Cuál es el horario?", `Abrimos ${days} desde las ${from}. ${DAYS.es.map((d, i) => `${d[0].toUpperCase() + d.slice(1)}: ${hoursLine(i)}`).join(". ")}.`],
  ["¿Hacéis pizza a domicilio?", `Sí. Puedes pedir a domicilio por Glovo y por Uber Eats, o llamar al ${site.phoneDisplay} y recogerla en el local. En las apps los precios pueden ser distintos a los del local.`],
  ["¿Tenéis pizzas sin carne?", `Sí: ${meatFree.join(", ")}. Si tienes alguna alergia o intolerancia, pregunta al personal antes de pedir.`],
  ["¿Cuánto cuesta una pizza?", `Las pizzas van de ${eur(Math.min(...cats.find((c) => c.id === "pizzas")!.items.map(minPrice)))} € a ${eur(Math.max(...cats.find((c) => c.id === "pizzas")!.items.map(minPrice)))} € en el local. La carta completa con precios está en ringopizzeria.com/carta.`],
] : [
  ["Where is Ringo Bar pizzeria?", `At ${site.address.street}, ${site.address.postalCode} ${site.address.city}, in the Campanar neighbourhood. Phone: ${site.phoneDisplay}.`],
  ["What are the opening hours?", `We're open ${days} from ${from}. ${DAYS.en.map((d, i) => `${d}: ${hoursLine(i)}`).join(". ")}.`],
  ["Do you deliver?", `Yes. Order delivery on Glovo or Uber Eats, or call ${site.phoneDisplay} and pick it up. App prices may differ from in-restaurant prices.`],
  ["Do you have meat-free pizzas?", `Yes: ${meatFree.join(", ")}. If you have an allergy or intolerance, please ask our staff before ordering.`],
  ["How much is a pizza?", `Pizzas cost from €${eur(Math.min(...cats.find((c) => c.id === "pizzas")!.items.map(minPrice)))} to €${eur(Math.max(...cats.find((c) => c.id === "pizzas")!.items.map(minPrice)))} in the restaurant. The full menu with prices is at ringopizzeria.com/en/menu.`],
];

const heroImg = await getImage({ src: hero, width: 1200, format: "jpg" });
const logoImg = await getImage({ src: logo, width: 400, format: "png" });
const jsonld = graph(
  restaurant(lang, new URL(heroImg.src, site.url).href, new URL(logoImg.src, site.url).href),
  website(lang),
  breadcrumbs([[es ? "Inicio" : "Home", R.home]]),
  faq(QA),
);
const gallery = [
  [g1, "g-a", es ? "Pizza blanca recién horneada sobre mármol" : "White pizza fresh from the oven on marble"],
  [g2, "g-b", es ? "Pizza con jamón serrano y albahaca" : "Pizza with serrano ham and basil"],
  [g3, "g-c", es ? "Pizza de tomate con albahaca" : "Tomato pizza with basil"],
  [g4, "g-d", es ? "Pizza de tomate servida en mesa" : "Tomato pizza served at the table"],
  [g5, "g-e", es ? "Pizza con jamón york y champiñones" : "Pizza with ham and mushrooms"],
] as const;
---
<Base lang={lang} title={title} description={description} path={R.home} altPath={ROUTES[es ? "en" : "es"].home} jsonld={jsonld}>
  <section class="hero">
    <div class="wrap">
      <div>
        <p class="eyebrow">{es ? "Pizzería italiana · Campanar, València" : "Italian pizzeria · Campanar, Valencia"}</p>
        <h1>{es ? <Fragment>La auténtica pizza <em>italiana</em> en Valencia.</Fragment> : <Fragment>Authentic <em>Italian</em> pizza in Valencia.</Fragment>}</h1>
        <p class="lede">{intro}</p>
        <div class="ctas">
          <a class="btn btn-primary order-cta" href={site.glovo} target="_blank" rel="noopener"><svg aria-hidden="true"><use href="#i-bag"/></svg>{t.order}</a>
          <a class="btn btn-ghost" href={R.carta}>{es ? "Ver la carta" : "See the menu"} <svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
        </div>
        <dl class="facts">
          <div><dt>{t.today}</dt><dd data-today>{hoursLine(1)}</dd></div>
          <div><dt>{es ? "Dirección" : "Address"}</dt><dd><a href={site.directions}>{site.address.street.replace("Carrer de ", "C/ ")}</a></dd></div>
          <div><dt>{es ? "Teléfono" : "Phone"}</dt><dd><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></dd></div>
        </dl>
      </div>
      <div class="hero-photo">
        <Image src={hero} alt={es ? "Pizza con tomate, mozzarella fresca y albahaca recién salida del horno" : "Pizza with tomato, fresh mozzarella and basil, straight from the oven"} widths={[480, 720, 960, 1200]} sizes="(max-width: 980px) 100vw, 560px" loading="eager" fetchpriority="high" />
        <div class="badge"><Image src={logo} alt={es ? "Logotipo de la Pizzería Ringo Bar" : "Ringo Bar Pizzeria logo"} width={192} /></div>
      </div>
    </div>
  </section>

  <section class="picks" aria-labelledby="picks-h">
    <div class="wrap">
      <div class="head">
        <h2 id="picks-h">{es ? <Fragment>Favoritas <em>de la casa</em></Fragment> : <Fragment>House <em>favourites</em></Fragment>}</h2>
        <p>{es ? "Para empezar: la pizza que lleva nuestro nombre y algunas especialidades." : "To start: the pizza that carries our name, and a few specialities."}</p>
      </div>
      <div class="picks-grid">
        <div class="picks-photo"><Image src={picksPhoto} alt={es ? "Pizza con jamón serrano, burrata y albahaca" : "Pizza with serrano ham, burrata and basil"} widths={[480, 720, 960]} sizes="(max-width: 980px) 100vw, 620px" /></div>
        <div>
          {picks.map((i) => (
            <div class="pick" data-soldout={i.soldOutOn ?? undefined}>
              <h3>{nameOf(i, lang)}{i.tags.includes("casa") && <span class="tag">{t.tags.casa}</span>}</h3>
              <span class="price">{priceLabel(i)}</span>
              {descOf(i, lang) && <p>{descOf(i, lang)}</p>}
            </div>
          ))}
          <a class="btn btn-light" href={R.carta}>{es ? "Ver la carta completa" : "See the full menu"} <svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
        </div>
      </div>
    </div>
  </section>

  <section class="menu" id="carta" aria-labelledby="carta-h">
    <div class="wrap">
      <div class="head">
        <h2 id="carta-h">{es ? <Fragment>Toda la <em>carta</em></Fragment> : <Fragment>The whole <em>menu</em></Fragment>}</h2>
        <p>{es ? "Pizzas, calzones, entrantes, paninis y postres, con precios y fotos. Es la misma carta que ves al escanear el QR de la mesa." : "Pizzas, calzones, starters, panini and desserts, with prices and photos. It's the same menu you get from the QR code on your table."}</p>
      </div>
      <div class="cat-grid">
        {cats.map((c, k) => (
          <a class={`cat-tile ${k === 0 ? "lead" : ""}`} href={`${R.carta}#${c.id}`} style={k === 0 ? `background-image:url(${heroImg.src})` : undefined}>
            <b>{catName(c, lang)}</b>
            <span>{c.items.length} · {es ? "desde" : "from"} {eur(Math.min(...c.items.map(minPrice).filter((p) => p > 0)))} € <svg aria-hidden="true"><use href="#i-arrow"/></svg></span>
          </a>
        ))}
      </div>
      <a class="btn btn-primary carta-cta" href={R.carta}>{es ? "Abrir la carta completa" : "Open the full menu"} <svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </div>
  </section>

  <section class="order" id="pedir" aria-labelledby="order-h">
    <div class="wrap">
      <div>
        <h2 id="order-h">{es ? <Fragment>¿Pizza en casa <em>esta noche?</em></Fragment> : <Fragment>Pizza at home <em>tonight?</em></Fragment>}</h2>
        <p>{es ? `Pídela por Glovo o Uber Eats y te la llevan a casa, ${days} desde las ${from}. Para recoger en el local, llámanos.` : `Order on Glovo or Uber Eats and get it delivered, ${days} from ${from}. For pick-up, give us a call.`}</p>
      </div>
      <div class="ctas order-ctas">
        <a class="btn btn-white order-cta" href={site.glovo} target="_blank" rel="noopener"><svg aria-hidden="true"><use href="#i-bag"/></svg>{t.glovo}</a>
        <a class="btn btn-light order-cta" href={site.ubereats} target="_blank" rel="noopener">{t.uber} <svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
        <a class="btn btn-light" href={`tel:${site.phone}`}><svg aria-hidden="true"><use href="#i-phone"/></svg>{t.pickup}{site.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <section id="galeria" aria-labelledby="gal-h">
    <div class="wrap">
      <div class="head">
        <h2 id="gal-h">{es ? <Fragment>Recién <em>salidas del horno</em></Fragment> : <Fragment>Fresh <em>from the oven</em></Fragment>}</h2>
        <p>{es ? "Fotos de nuestra cocina. Síguenos en Instagram para ver las de cada día." : "Photos from our kitchen. Follow us on Instagram for today's."}</p>
      </div>
      <div class="gallery-grid">
        {gallery.map(([src, cls, alt]) => (
          <figure class={cls}><Image src={src} alt={alt} widths={[400, 700, 1000]} sizes="(max-width: 640px) 50vw, 40vw" /></figure>
        ))}
      </div>
      <div class="insta">
        <span>{site.instagramHandle} {es ? "en Instagram" : "on Instagram"}</span>
        <a class="btn btn-ghost" href={site.instagram} rel="noopener">{es ? "Ver Instagram" : "See Instagram"} <svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
    </div>
  </section>

  <section class="visit" id="visitanos" aria-labelledby="visit-h">
    <div class="wrap">
      <div class="head"><h2 id="visit-h">{es ? <Fragment>Ven a <em>vernos</em></Fragment> : <Fragment>Come and <em>see us</em></Fragment>}</h2></div>
      <div class="visit-grid">
        <div>
          <h3>{es ? "Horario" : "Opening hours"}</h3>
          <table class="hours"><tbody data-hours>
            {DAYS[lang].map((d, i) => <tr class={hours.week[i].length ? "" : "closed"}><td>{d[0].toUpperCase() + d.slice(1)}</td><td>{hoursLine(i)}</td></tr>)}
          </tbody></table>
          {closedDays.length > 0 && <p class="menu-note" style="margin-top:14px">{es ? "Festivos y vacaciones: lo avisamos aquí arriba y en Google." : "Holidays and closures are announced at the top of this page and on Google."}</p>}
        </div>
        <div>
          <h3>{es ? "Dirección" : "Address"}</h3>
          <address>{site.address.street}<br>{site.address.postalCode} {site.address.city} ({site.address.neighbourhood})</address>
          <h3>{es ? "Teléfono" : "Phone"}</h3>
          <a class="big-phone" href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
          <div class="stack"><a class="btn btn-primary" href={site.directions}><svg aria-hidden="true"><use href="#i-pin"/></svg>{t.directions}</a></div>
        </div>
        <a class="map" href={site.maps} aria-label={es ? "Abrir Ringo Bar en Google Maps" : "Open Ringo Bar in Google Maps"}>
          <Image src={mapImg} alt={es ? "Mapa de la ubicación de Ringo Bar en Campanar" : "Map of Ringo Bar's location in Campanar"} widths={[400, 700]} sizes="(max-width: 980px) 100vw, 440px" />
          <span>{es ? "Abrir en Google Maps" : "Open in Google Maps"}</span>
        </a>
      </div>
    </div>
  </section>

  <section class="faq" aria-labelledby="faq-h">
    <div class="wrap">
      <div class="head"><h2 id="faq-h">{es ? <Fragment>Preguntas <em>frecuentes</em></Fragment> : <Fragment>Frequently asked <em>questions</em></Fragment>}</h2></div>
      <div class="faq-list">
        {QA.map(([q, a]) => <details><summary><h3>{q}</h3></summary><p>{a}</p></details>)}
      </div>
    </div>
  </section>
</Base>
